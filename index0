
<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#151128">
<meta name="description" content="별을 터치하고 피버를 터뜨리는 모바일 리듬 게임">
<title>별빛 리듬 CLUB</title>
<style>
:root {
  color-scheme: dark;
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  --pink: #ffa6d6;
  --mint: #91f5dc;
  --muted: #bfb5d4;
}
* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; overscroll-behavior: none; }
body {
  overflow: hidden;
  color: #fff;
  background:
    radial-gradient(ellipse at top, #4c2864, transparent 65%),
    #100d1d;
}
button, select, input { font: inherit; }
button, select { min-height: 44px; }
button {
  cursor: pointer;
  -webkit-tap-highlight-color: transparent;
}
button:disabled { opacity: .45; cursor: default; }
button:focus-visible, select:focus-visible, input:focus-visible {
  outline: 3px solid var(--mint);
  outline-offset: 3px;
}
[hidden] { display: none !important; }
.app {
  width: min(100%, 600px);
  height: 100vh;
  height: 100dvh;
  margin: auto;
  padding: max(8px, env(safe-area-inset-top)) 10px
    max(8px, env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  gap: 8px;
}
header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
}
h1 { margin: 0; font-size: clamp(18px, 5vw, 25px); }
h1 small { color: var(--pink); font-size: 11px; }
.tools { display: flex; gap: 6px; }
.icon {
  border: 1px solid #ffffff22;
  background: #ffffff0b;
  color: white;
  border-radius: 13px;
  min-width: 44px;
}
.stats {
  display: grid;
  grid-template-columns: 1.2fr 1fr 1fr;
  gap: 7px;
}
.stat {
  padding: 7px 4px;
  text-align: center;
  border: 1px solid #ffffff13;
  background: #ffffff08;
  border-radius: 15px;
}
.stat span { font-size: 10px; color: var(--muted); }
.stat strong {
  display: block;
  font-size: clamp(18px, 5vw, 25px);
  font-variant-numeric: tabular-nums;
}
#combo { color: var(--pink); }
#accuracy { color: var(--mint); }
.meters { display: flex; align-items: center; gap: 8px; }
.meters span {
  min-width: 68px;
  color: #ffe59e;
  font-size: 11px;
  font-weight: 800;
}
.bar {
  flex: 1;
  height: 8px;
  background: #ffffff12;
  border-radius: 20px;
  overflow: hidden;
}
.bar i {
  display: block;
  height: 100%;
  width: 0;
  background: linear-gradient(90deg, #ffa6d6, #ffe59e);
}
#progress { height: 3px; flex: none; }
#progress i { background: #a79cff; }
.stage {
  position: relative;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  border: 1px solid #ffffff20;
  border-radius: 23px;
  background: #151128;
}
canvas {
  display: block;
  width: 100%;
  height: 100%;
  touch-action: none;
  user-select: none;
  -webkit-user-select: none;
}
.overlay {
  position: absolute;
  inset: 0;
  padding: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: auto;
  background: #110d22ed;
}
.panel {
  width: 100%;
  max-width: 380px;
  max-height: 100%;
  overflow: auto;
  padding: 4px;
  text-align: center;
}
.hero { font-size: 43px; }
h2 { margin: 5px 0 8px; font-size: 27px; }
.description {
  color: var(--muted);
  font-size: 13px;
  line-height: 1.65;
  margin: 0 0 12px;
  white-space: pre-line;
}
.settings { display: grid; gap: 10px; margin-bottom: 12px; }
label {
  display: grid;
  gap: 5px;
  color: var(--muted);
  text-align: left;
  font-size: 12px;
}
select {
  width: 100%;
  border: 1px solid #ffffff25;
  background: #2b2341;
  color: white;
  padding: 9px;
  border-radius: 12px;
}
input[type=range] { width: 100%; accent-color: var(--pink); }
details {
  text-align: left;
  color: var(--muted);
  font-size: 12px;
}
summary { cursor: pointer; padding: 6px 0; }
.help { font-size: 11px; line-height: 1.6; }
.primary, .secondary {
  width: 100%;
  padding: 13px;
  border-radius: 15px;
  font-weight: 800;
}
.primary {
  color: #281431;
  border: none;
  background: linear-gradient(110deg, #ffacd6, #c3b1ff, #9cf3de);
}
.secondary {
  margin-top: 8px;
  color: white;
  border: 1px solid #ffffff25;
  background: #ffffff08;
}
.best { font-size: 11px; color: #ffe59e; margin: 12px 0 4px; }
.results {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
  margin: 12px 0;
}
.result {
  background: #ffffff08;
  border-radius: 12px;
  padding: 9px;
  font-size: 11px;
  color: var(--muted);
}
.result strong {
  display: block;
  font-size: 21px;
  margin-top: 3px;
  color: white;
}
footer { color: var(--muted); text-align: center; font-size: 10px; }
@media (max-height: 650px) {
  .app { gap: 5px; }
  .stat { padding: 3px; }
  .hero { display: none; }
  h2 { font-size: 22px; }
  .settings { gap: 6px; }
  .description { font-size: 12px; }
}
</style>
</head>
<body>
<main class="app">
  <header>
    <h1>별빛 리듬 <small>CLUB ✦</small></h1>
    <div class="tools">
      <button id="sound" class="icon" aria-label="음소거">🔊</button>
      <button id="pause" class="icon" aria-label="일시정지" disabled>⏸</button>
    </div>
  </header>

  <section class="stats" aria-label="게임 점수">
    <div class="stat"><span>SCORE</span><strong id="score">0</strong></div>
    <div class="stat"><span>COMBO</span><strong id="combo">0</strong></div>
    <div class="stat"><span>정확도</span><strong id="accuracy">100%</strong></div>
  </section>

  <div class="meters">
    <span id="feverLabel">⚡ FEVER</span>
    <div class="bar"><i id="feverFill"></i></div>
  </div>

  <div id="progress" class="bar" aria-label="곡 진행">
    <i id="progressFill"></i>
  </div>

  <section class="stage">
    <canvas id="canvas" tabindex="0"
      aria-label="별이 아래 판정선에 닿으면 해당 열을 터치하거나 D F J K 키를 누르세요."></canvas>

    <div id="overlay" class="overlay">
      <section class="panel">
        <div id="hero" class="hero">🌠</div>
        <h2 id="title">오늘 밤, 별빛 무대!</h2>
        <p id="description" class="description"></p>

        <div id="results" class="results" hidden></div>

        <div id="settings" class="settings">
          <label>곡 선택
            <select id="song">
              <option value="candy">🍭 캔디 별자리 · 104 BPM</option>
              <option value="moon">🌙 달빛 산책 · 116 BPM</option>
              <option value="galaxy">🚀 은하수 여행 · 128 BPM</option>
            </select>
          </label>

          <label>난이도
            <select id="difficulty">
              <option value="easy">🌱 쉬움 · 한 손가락부터</option>
              <option value="normal">✨ 보통 · 리듬에 맞춰</option>
              <option value="hard">🔥 도전 · 빠른 별과 동시치기</option>
            </select>
          </label>

          <details>
            <summary>🎧 조작 방법 / 타이밍 설정</summary>
            <p class="help">
              별의 중심이 선에 닿으면 해당 열을 터치하세요.<br>
              PC는 D F J K · 도전 난이도는 두 열 동시 입력이 있어요.<br>
              콤보를 쌓으면 피버 발동! 8초 동안 점수가 2배예요.<br>
              빈 곳을 연타하면 콤보와 피버 게이지가 줄어들어요.<br>
              블루투스 이어폰보다 스피커·유선 이어폰을 추천해요.
            </p>
            <label>
              <span>타이밍 보정 <output id="offsetLabel">0ms</output></span>
              <input id="offset" type="range" min="-200" max="200" step="10" value="0">
            </label>
            <p class="help">
              음악에 맞췄는데 늦게 판정된다면 + 방향으로 조절해 보세요.
              보정값은 다음 게임부터 적용돼요.
            </p>
          </details>
        </div>

        <button id="start" class="primary">무대 시작 ▶</button>
        <button id="home" class="secondary" hidden>처음 화면으로</button>
        <p id="best" class="best"></p>
      </section>
    </div>
  </section>
  <footer>📱 해당 열 어디든 터치 · ⌨ D F J K · ESC 일시정지</footer>
</main>

<script>
"use strict";

const $ = id => document.getElementById(id);
const canvas = $("canvas");
const g = canvas.getContext("2d");

const COLORS = ["#ffa6d6", "#bba6ff", "#91f5dc", "#ffe59e"];
const KEYS = ["D", "F", "J", "K"];
const KEYMAP = { KeyD: 0, KeyF: 1, KeyJ: 2, KeyK: 3 };
const REDUCED = matchMedia("(prefers-reduced-motion: reduce)").matches;

const SONGS = {
  candy: {
    name: "캔디 별자리", bpm: 104, seed: 17,
    roots: [48, 45, 53, 55],
    melody: [72,76,79,76,74,77,81,77,71,74,79,74,72,76,79,84]
  },
  moon: {
    name: "달빛 산책", bpm: 116, seed: 42,
    roots: [45, 53, 48, 55],
    melody: [69,72,76,79,76,72,74,76,77,76,72,69,71,74,76,71]
  },
  galaxy: {
    name: "은하수 여행", bpm: 128, seed: 91,
    roots: [50, 46, 53, 48],
    melody: [74,77,81,86,81,77,76,79,82,79,77,74,72,76,79,84]
  }
};

const LEVELS = {
  easy:   { travel: 2.6, perfect: .075, good: .125, window: .20 },
  normal: { travel: 2.1, perfect: .060, good: .105, window: .17 },
  hard:   { travel: 1.7, perfect: .050, good: .090, window: .145 }
};

const BEATS = 96;
const LEAD = 3;
const FEVER_LENGTH = 8;

let w = 1, h = 1;
let state = "menu";
let songId = "candy", difficulty = "easy";
let song = SONGS.candy, level = LEVELS.easy;
let beat = 60 / song.bpm, endTime = 60, offset = 0;
let notes = [], particles = [], rings = [];
let flashes = [0,0,0,0];
let lastTap = [-99,-99,-99,-99];
let held = new Set();

let score = 0, combo = 0, maxCombo = 0;
let judged = 0, earned = 0, stray = 0;
let counts = { perfect: 0, good: 0, ok: 0, miss: 0 };
let energy = 0, feverUntil = 0, feverCount = 0;
let message = null, banner = null;

let audio = null, master = null, origin = 0;
let timer = null, nextBeat = 0, nextNote = 0;
let muted = false, busy = false, suspendPromise = Promise.resolve();
let lastFrame = 0;

function read(key, fallback) {
  try { return localStorage.getItem("starclub-" + key) ?? fallback; }
  catch { return fallback; }
}
function save(key, value) {
  try { localStorage.setItem("starclub-" + key, String(value)); }
  catch {}
}
function bestKey() {
  return "best-" + $("song").value + "-" + $("difficulty").value;
}
function bestScore(key = bestKey()) {
  const value = Number(read(key, "0"));
  return Number.isFinite(value) ? Math.max(0, value) : 0;
}
function refreshBest() {
  $("best").textContent = "🏆 선택한 곡·난이도 최고 점수  " +
    bestScore().toLocaleString("ko-KR");
}
function accuracy() {
  return judged ? earned / judged * 100 : 100;
}
function stats() {
  $("score").textContent = score.toLocaleString("ko-KR");
  $("combo").textContent = combo;
  $("accuracy").textContent = accuracy().toFixed(1) + "%";
}
function panel(title, text, hero, button) {
  $("title").textContent = title;
  $("description").textContent = text;
  $("hero").textContent = hero;
  $("start").textContent = button;
  $("overlay").hidden = false;
}
function clock() {
  return audio ? audio.currentTime - origin : 0;
}
function isFever(t) {
  return feverUntil > t;
}
function stopAudio() {
  clearInterval(timer);
  timer = null;
  const old = audio;
  audio = null;
  master = null;
  if (old && old.state !== "closed") old.close().catch(() => {});
}
function menu() {
  state = "menu";
  stopAudio();
  held.clear();
  notes = [];
  particles = [];
  rings = [];
  message = banner = null;
  flashes = [0,0,0,0];
  $("pause").disabled = true;
  $("settings").hidden = false;
  $("results").hidden = true;
  $("home").hidden = true;
  $("feverLabel").textContent = "⚡ FEVER";
  $("feverFill").style.width = "0%";
  $("progressFill").style.width = "0%";
  panel(
    "오늘 밤, 별빛 무대!",
    "내려오는 별을 리듬에 맞춰 톡!\n콤보를 모아 피버를 터뜨려 보세요.\n실수해도 괜찮아요. 끝까지 연주할 수 있어요!",
    "🌠", "무대 시작 ▶"
  );
  refreshBest();
}

/* ---------- 채보 ---------- */

function randomGenerator(seed) {
  let x = seed >>> 0;
  return () => {
    x = (Math.imul(x, 1664525) + 1013904223) >>> 0;
    return x / 4294967296;
  };
}
function makeChart() {
  const random = randomGenerator(song.seed);
  const result = [];
  let previous = -1;

  function add(b, chord = false) {
    let lane = Math.floor(random() * 4);
    if (lane === previous) lane = (lane + 1 + Math.floor(random()*3)) % 4;
    previous = lane;
    const midi = song.melody[Math.floor(b * 2) % song.melody.length];

    result.push({
      time: LEAD + b * beat, lane, midi, done: false, chord
    });

    if (chord) {
      result.push({
        time: LEAD + b * beat,
        lane: (lane + 2) % 4,
        midi: midi - 12,
        done: false,
        chord: true
      });
    }
  }

  for (let b = 0; b < BEATS; b++) {
    if (difficulty === "easy") {
      if (b % 2 === 0 || (b >= 48 && b % 8 === 5)) add(b);
    } else if (difficulty === "normal") {
      add(b);
      if (b >= 16 && b % 8 === 6) add(b + .5);
    } else {
      const chord = b >= 16 && b % 8 === 0;
      add(b, chord);
      if (!chord && b % 4 !== 3) add(b + .5);
    }
  }
  return result.sort((a,b) => a.time - b.time);
}

/* ---------- Web Audio 합성 음악 ---------- */

function tone(midi, when, duration, volume, type = "sine") {
  if (!audio || !master) return;
  const oscillator = audio.createOscillator();
  const gain = audio.createGain();

  oscillator.type = type;
  oscillator.frequency.setValueAtTime(
    440 * Math.pow(2, (midi - 69) / 12), when
  );
  gain.gain.setValueAtTime(.0001, when);
  gain.gain.exponentialRampToValueAtTime(volume, when + .01);
  gain.gain.exponentialRampToValueAtTime(.0001, when + duration);

  oscillator.connect(gain);
  gain.connect(master);
  oscillator.start(when);
  oscillator.stop(when + duration + .03);
  oscillator.onended = () => {
    oscillator.disconnect();
    gain.disconnect();
  };
}
function drum(when, kick = true) {
  if (!audio || !master) return;
  const oscillator = audio.createOscillator();
  const gain = audio.createGain();
  oscillator.type = kick ? "sine" : "triangle";
  oscillator.frequency.setValueAtTime(kick ? 150 : 1800, when);
  oscillator.frequency.exponentialRampToValueAtTime(
    kick ? 45 : 600, when + .08
  );
  gain.gain.setValueAtTime(kick ? .42 : .045, when);
  gain.gain.exponentialRampToValueAtTime(.0001, when + (kick ? .18 : .05));
  oscillator.connect(gain);
  gain.connect(master);
  oscillator.start(when);
  oscillator.stop(when + .2);
  oscillator.onended = () => {
    oscillator.disconnect();
    gain.disconnect();
  };
}
function schedule() {
  if (!audio || state !== "running") return;
  const now = clock();
  const horizon = now + .16;

  while (nextBeat < BEATS && LEAD + nextBeat * beat <= horizon) {
    const t = LEAD + nextBeat * beat;
    if (t >= now - .04) {
      const when = Math.max(audio.currentTime + .003, origin + t);
      const root = song.roots[Math.floor(nextBeat / 8) % 4];
      drum(when, nextBeat % 2 === 0);

      if (nextBeat % 2 === 0) tone(root, when, .3, .26, "triangle");

      if (nextBeat % 4 === 0) {
        const minor = [45, 50].includes(root);
        [0, minor ? 3 : 4, 7].forEach(n => {
          tone(root + 12 + n, when, beat * 3.5, .065);
        });
      }
      if (isFever(t)) {
        tone(root + 24, when, .12, .075, "triangle");
      }
    }
    nextBeat++;
  }

  while (nextNote < notes.length && notes[nextNote].time <= horizon) {
    const note = notes[nextNote];
    if (note.time >= now - .04) {
      const when = Math.max(audio.currentTime + .003, origin + note.time);
      tone(note.midi, when, .27, .21, "triangle");
      tone(note.midi + 12, when, .15, .035);
    }
    nextNote++;
  }
}
function scheduler() {
  clearInterval(timer);
  schedule();
  timer = setInterval(schedule, 25);
}

/* ---------- 시작 / 일시정지 / 결과 ---------- */

async function startGame() {
  stopAudio();
  const AudioClass = window.AudioContext || window.webkitAudioContext;
  if (!AudioClass) throw new Error("최신 Safari 또는 Chrome으로 열어 주세요.");

  songId = $("song").value;
  difficulty = $("difficulty").value;
  song = SONGS[songId];
  level = LEVELS[difficulty];
  beat = 60 / song.bpm;
  offset = Number($("offset").value) / 1000;
  endTime = LEAD + BEATS * beat + 1.5;

  notes = makeChart();
  particles = [];
  rings = [];
  flashes = [0,0,0,0];
  lastTap = [-99,-99,-99,-99];
  held.clear();
  score = combo = maxCombo = judged = earned = stray = 0;
  energy = feverUntil = feverCount = 0;
  counts = { perfect: 0, good: 0, ok: 0, miss: 0 };
  message = banner = null;
  nextBeat = nextNote = 0;

  audio = new AudioClass({ latencyHint: "interactive" });
  master = audio.createGain();
  master.gain.value = muted ? 0 : .38;
  const compressor = audio.createDynamicsCompressor();
  master.connect(compressor);
  compressor.connect(audio.destination);

  await audio.resume();
  if (audio.state !== "running") throw new Error("소리를 시작하지 못했어요. 다시 눌러 주세요.");

  origin = audio.currentTime;
  state = "running";
  $("overlay").hidden = true;
  $("pause").disabled = false;
  stats();
  scheduler();

  audio.onstatechange = () => {
    if (state === "running" && audio && audio.state !== "running") pauseGame();
  };

  if (document.hidden) {
    await pauseGame();
  } else {
    canvas.focus({ preventScroll: true });
  }
}
async function pauseGame() {
  if (state !== "running" || !audio) return;
  state = "paused";
  held.clear();
  clearInterval(timer);
  $("pause").disabled = true;
  $("settings").hidden = true;
  $("results").hidden = true;
  $("home").hidden = false;
  panel(
    "잠깐 쉬어가요",
    "음악과 별이 멈췄어요.\n이어하기를 누르면 같은 자리에서 재개돼요.",
    "🌙", "이어하기 ▶"
  );
  suspendPromise = audio.state === "running"
    ? audio.suspend().catch(() => {})
    : Promise.resolve();
  await suspendPromise;
}
async function resumeGame() {
  await suspendPromise;
  if (!audio || state !== "paused") return;
  await audio.resume();
  if (audio.state !== "running") throw new Error("소리 재개에 실패했어요. 다시 눌러 주세요.");
  state = "running";
  $("overlay").hidden = true;
  $("pause").disabled = false;
  scheduler();
  if (document.hidden) await pauseGame();
  else canvas.focus({ preventScroll: true });
}
function resultItem(label, value) {
  const item = document.createElement("div");
  item.className = "result";
  const text = document.createElement("span");
  const strong = document.createElement("strong");
  text.textContent = label;
  strong.textContent = value;
  item.append(text, strong);
  $("results").append(item);
}
function finish() {
  state = "finished";
  stopAudio();
  $("pause").disabled = true;
  $("settings").hidden = false;
  $("results").hidden = false;
  $("results").replaceChildren();
  $("home").hidden = false;

  const acc = accuracy();
  const rank = acc >= 98 ? "S+" : acc >= 95 ? "S" :
    acc >= 90 ? "A" : acc >= 80 ? "B" : acc >= 65 ? "C" : "D";

  const key = "best-" + songId + "-" + difficulty;
  const record = score > bestScore(key);
  if (record) save(key, score);

  const fullCombo = counts.miss === 0 && stray === 0;
  let award = fullCombo ? "🌈 FULL COMBO!" :
    acc >= 90 ? "💎 반짝이는 연주!" :
    "🌱 완주 성공! 다음 무대도 도전해요.";

  if (record) award += "\n🏆 새로운 최고 기록!";
  panel(song.name + " 완주!", award, "🏆", "다시 무대 시작 ▶");

  resultItem("최종 점수", score.toLocaleString("ko-KR"));
  resultItem("등급", rank);
  resultItem("최대 콤보", maxCombo);
  resultItem("정확도", acc.toFixed(1) + "%");
  resultItem("PERFECT / GOOD", counts.perfect + " / " + counts.good);
  resultItem("OK / MISS", counts.ok + " / " + counts.miss);
  resultItem("피버 발동", feverCount + "회");
  resultItem("빈 곳 터치", stray + "회");

  $("progressFill").style.width = "100%";
  $("feverFill").style.width = "0%";
  $("feverLabel").textContent = "⚡ FEVER";
  refreshBest();
  $("start").focus({ preventScroll: true });
}

/* ---------- 판정 / 피버 ---------- */

function announce(text, color, time) {
  message = { text, color, until: time + .65 };
}
function burst(lane) {
  flashes[lane] = 1;
  if (REDUCED) return;
  const x = center(lane), y = lineY();
  rings.push({ x, y, life: .45, color: COLORS[lane] });

  for (let i = 0; i < 10; i++) {
    const angle = Math.random() * Math.PI * 2;
    const speed = 60 + Math.random() * 140;
    particles.push({
      x, y,
      vx: Math.cos(angle) * speed,
      vy: Math.sin(angle) * speed - 30,
      life: .55, size: 2 + Math.random()*4,
      color: COLORS[lane]
    });
  }
  if (particles.length > 220) particles.splice(0, particles.length - 220);
  if (rings.length > 30) rings.shift();
}
function judge(note, type, time) {
  if (note.done) return;
  note.done = true;
  judged++;
  counts[type]++;

  const data = {
    perfect: [1000, 1, "PERFECT ✦", "#ffe59e", 8],
    good: [700, .75, "GOOD", "#91f5dc", 5],
    ok: [400, .4, "OK", "#bba6ff", 2],
    miss: [0, 0, "MISS", "#ff8daf", -18]
  }[type];

  earned += data[1];

  if (type === "miss") {
    combo = 0;
    if (!isFever(time)) energy = Math.max(0, energy + data[4]);
  } else {
    combo++;
    maxCombo = Math.max(maxCombo, combo);
    const multiplier = isFever(time) ? 2 : 1;
    const comboBonus = Math.min(200, Math.floor(combo / 10) * 20);
    score += (data[0] + comboBonus) * multiplier;
    burst(note.lane);

    if (!isFever(time)) {
      energy = Math.min(100, energy + data[4]);
      if (energy >= 100) {
        energy = 0;
        feverUntil = time + FEVER_LENGTH;
        feverCount++;
        banner = { text: "⚡ FEVER! 점수 ×2", until: time + 1.6 };
      }
    }
    if (combo % 25 === 0 && !isFever(time)) {
      banner = { text: combo + " COMBO! 멋져요 ✨", until: time + 1.2 };
    }
  }
  announce(data[2], data[3], time);
  stats();
}
function hit(lane) {
  if (state !== "running" || !audio) return;
  const now = clock();
  if (now - lastTap[lane] < .075) return;
  lastTap[lane] = now;
  flashes[lane] = 1;

  const t = now - offset;
  let nearest = null, distance = Infinity;

  for (const note of notes) {
    if (note.done || note.lane !== lane) continue;
    const d = Math.abs(note.time - t);
    if (d <= level.window && d < distance) {
      nearest = note;
      distance = d;
    }
  }

  if (!nearest) {
    // 카운트다운과 곡이 끝난 뒤에는 빈 입력을 벌점으로 세지 않습니다.
    if (t < LEAD - level.window || t > notes[notes.length-1].time + level.window) return;
    stray++;
    combo = 0;
    if (!isFever(now)) energy = Math.max(0, energy - 10);
    announce("리듬을 기다려요", "#c5b6df", now);
    stats();
    return;
  }

  judge(nearest,
    distance <= level.perfect ? "perfect" :
    distance <= level.good ? "good" : "ok", now);
}

/* ---------- 입력 ---------- */

canvas.addEventListener("pointerdown", event => {
  if (state !== "running") return;
  if (event.pointerType === "mouse" && event.button !== 0) return;
  event.preventDefault();
  const rect = canvas.getBoundingClientRect();
  const lane = Math.max(0, Math.min(3,
    Math.floor((event.clientX - rect.left) / (rect.width / 4))
  ));
  hit(lane);
});
canvas.addEventListener("contextmenu", event => event.preventDefault());

window.addEventListener("keydown", event => {
  if (event.code === "Escape" && state === "running") {
    event.preventDefault();
    pauseGame();
    return;
  }
  if (state !== "running") return;
  if (event.target instanceof HTMLElement &&
      event.target.matches("input,select,textarea,button")) return;
  const lane = KEYMAP[event.code];
  if (lane === undefined) return;
  event.preventDefault();
  if (event.repeat || held.has(event.code)) return;
  held.add(event.code);
  hit(lane);
});
window.addEventListener("keyup", event => held.delete(event.code));
window.addEventListener("blur", () => {
  held.clear();
  if (state === "running") pauseGame();
});
document.addEventListener("visibilitychange", () => {
  if (document.hidden && state === "running") pauseGame();
});

$("start").addEventListener("click", async () => {
  if (busy) return;
  busy = true;
  $("start").disabled = true;
  $("home").disabled = true;

  try {
    if (state === "paused") await resumeGame();
    else await startGame();
  } catch (error) {
    const text = error instanceof Error ? error.message : "다시 시도해 주세요.";
    if (state === "paused" && audio) {
      panel("잠깐 확인해 주세요", text, "🌙", "이어하기 ▶");
    } else {
      menu();
      panel("잠깐 확인해 주세요", text, "🌟", "다시 시작 ▶");
    }
  } finally {
    busy = false;
    $("start").disabled = false;
    $("home").disabled = false;
  }
});
$("pause").addEventListener("click", pauseGame);
$("home").addEventListener("click", () => { if (!busy) menu(); });

function soundButton() {
  $("sound").textContent = muted ? "🔇" : "🔊";
  $("sound").setAttribute("aria-label", muted ? "소리 켜기" : "음소거");
  $("sound").setAttribute("aria-pressed", String(muted));
}
$("sound").addEventListener("click", () => {
  muted = !muted;
  save("muted", muted);
  soundButton();
  if (audio && master) {
    master.gain.setTargetAtTime(muted ? 0 : .38, audio.currentTime, .03);
  }
  if (state === "running") canvas.focus({ preventScroll: true });
});

["song", "difficulty"].forEach(id => {
  const saved = read(id, $(id).value);
  if ([...$(id).options].some(option => option.value === saved)) $(id).value = saved;
  $(id).addEventListener("change", () => {
    save(id, $(id).value);
    refreshBest();
  });
});
const savedOffset = Number(read("offset", "0"));
$("offset").value = Number.isFinite(savedOffset)
  ? Math.max(-200, Math.min(200, savedOffset)) : 0;
function offsetLabel() {
  const value = Number($("offset").value);
  $("offsetLabel").textContent = (value > 0 ? "+" : "") + value + "ms";
  save("offset", value);
}
$("offset").addEventListener("input", offsetLabel);

/* ---------- 캔버스 ---------- */

function resize() {
  const rect = canvas.getBoundingClientRect();
  w = Math.max(1, rect.width);
  h = Math.max(1, rect.height);
  const dpr = Math.min(devicePixelRatio || 1, 2.5);
  canvas.width = Math.round(w * dpr);
  canvas.height = Math.round(h * dpr);
  g.setTransform(dpr, 0, 0, dpr, 0, 0);
}
function lineY() { return h - Math.min(82, h * .22); }
function center(lane) { return (lane + .5) * w / 4; }
function star(x, y, radius, color, rotation = 0) {
  g.save();
  g.translate(x, y);
  g.rotate(rotation);
  g.beginPath();
  for (let i = 0; i < 10; i++) {
    const a = -Math.PI / 2 + i * Math.PI / 5;
    const r = i % 2 ? radius * .46 : radius;
    const px = Math.cos(a) * r, py = Math.sin(a) * r;
    if (i === 0) g.moveTo(px, py);
    else g.lineTo(px, py);
  }
  g.closePath();
  g.fillStyle = color;
  g.fill();
  g.restore();
}
function text(value, x, y, size, color = "#fff") {
  g.save();
  g.textAlign = "center";
  g.textBaseline = "middle";
  g.font = `800 ${size}px system-ui, sans-serif`;
  g.fillStyle = color;
  g.fillText(value, x, y);
  g.restore();
}
function drawBackground(t, timestamp) {
  g.clearRect(0, 0, w, h);
  const fever = state === "running" && isFever(t);
  const gradient = g.createLinearGradient(0,0,0,h);
  gradient.addColorStop(0, fever ? "#442348" : "#251b3c");
  gradient.addColorStop(1, "#100e20");
  g.fillStyle = gradient;
  g.fillRect(0,0,w,h);

  for (let i = 0; i < 36; i++) {
    const x = ((i * 79 + 23) % 997) / 997 * w;
    const y = ((i * 137 + 11) % 991) / 991 * h;
    g.globalAlpha = REDUCED ? .4 : .35 + Math.sin(timestamp*.001 + i)*.2;
    g.fillStyle = "#fff";
    g.fillRect(x,y,i%3 === 0 ? 2 : 1.2, i%3 === 0 ? 2 : 1.2);
  }
  g.globalAlpha = 1;

  const laneWidth = w / 4;
  const y = lineY();

  for (let lane = 0; lane < 4; lane++) {
    const x = lane * laneWidth;
    g.fillStyle = lane % 2 ? "#ffffff06" : "#ffffff02";
    g.fillRect(x,0,laneWidth,h);

    g.fillStyle = COLORS[lane];
    g.globalAlpha = flashes[lane] * .20;
    g.fillRect(x,0,laneWidth,h);
    g.globalAlpha = .07;
    g.fillRect(x+4,y+10,laneWidth-8,Math.max(0,h-y-16));
    g.globalAlpha = 1;

    if (lane) {
      g.strokeStyle = "#ffffff14";
      g.lineWidth = 1;
      g.beginPath();
      g.moveTo(x,0);
      g.lineTo(x,h);
      g.stroke();
    }
    g.strokeStyle = COLORS[lane];
    g.lineWidth = 2;
    g.beginPath();
    g.arc(center(lane),y,Math.min(23,laneWidth*.25),0,Math.PI*2);
    g.stroke();
    text(KEYS[lane],center(lane),y+(h-y)*.57,17,COLORS[lane]);
  }

  // 节拍参考线：辅助识别节奏
  if (state === "running" || state === "paused") {
    const visualTime = t - offset;
    const from = Math.max(0, Math.floor((visualTime-LEAD)/beat)-1);
    for (let b = from; b < from+10 && b < BEATS; b++) {
      const remaining = LEAD + b*beat - visualTime;
      if (remaining > level.travel || remaining < 0) continue;
      const by = -30 + (1-remaining/level.travel)*(y+30);
      g.strokeStyle = b%4 === 0 ? "#ffffff18" : "#ffffff08";
      g.beginPath();
      g.moveTo(0,by);
      g.lineTo(w,by);
      g.stroke();
    }
  }

  g.save();
  g.strokeStyle = fever ? "#ffe59e" : "#eadcff";
  g.shadowColor = fever ? "#ffb955" : "#bd9fff";
  g.shadowBlur = REDUCED ? 0 : 12;
  g.lineWidth = 2;
  g.beginPath();
  g.moveTo(0,y);
  g.lineTo(w,y);
  g.stroke();
  g.restore();

  if (fever) {
    g.strokeStyle = "#ffe59e88";
    g.lineWidth = 3;
    g.strokeRect(2,2,w-4,h-4);
  }
}
function drawNotes(t) {
  const visualTime = t - offset;
  const target = lineY();
  const radius = Math.min(23,w*.06);

  for (const note of notes) {
    if (note.done) continue;
    const remaining = note.time - visualTime;
    if (remaining > level.travel + .2) continue;
    const y = -30 + (1-remaining/level.travel)*(target+30);
    if (y < -45 || y > h+45) continue;
    const x = center(note.lane);
    const color = COLORS[note.lane];

    g.save();
    const trail = g.createLinearGradient(x,y-48,x,y);
    trail.addColorStop(0,color+"00");
    trail.addColorStop(1,color+"66");
    g.fillStyle = trail;
    g.fillRect(x-8,y-48,16,43);

    g.shadowColor = color;
    g.shadowBlur = REDUCED ? 0 : 14;
    star(x,y,radius,color);
    g.shadowBlur = 0;
    star(x-2,y-3,radius*.3,"#ffffffbb");

    if (note.chord) {
      g.strokeStyle = "#ffffffbb";
      g.lineWidth = 1.5;
      g.beginPath();
      g.arc(x,y,radius+5,0,Math.PI*2);
      g.stroke();
    }
    g.restore();
  }
}
function effects(delta) {
  for (let i = 0; i < 4; i++) flashes[i] = Math.max(0,flashes[i]-delta*4);
  for (const p of particles) {
    p.life -= delta;
    p.x += p.vx*delta;
    p.y += p.vy*delta;
    p.vy += 170*delta;
  }
  for (const r of rings) r.life -= delta;
  particles = particles.filter(p => p.life > 0);
  rings = rings.filter(r => r.life > 0);
}
function drawEffects() {
  for (const p of particles) {
    g.globalAlpha = Math.max(0,p.life/.55);
    star(p.x,p.y,p.size,p.color);
  }
  for (const r of rings) {
    g.globalAlpha = Math.max(0,r.life/.45);
    g.strokeStyle = r.color;
    g.lineWidth = 2;
    g.beginPath();
    g.arc(r.x,r.y,18+(1-r.life/.45)*48,0,Math.PI*2);
    g.stroke();
  }
  g.globalAlpha = 1;
}
function drawMessages(t) {
  if (message && t < message.until) {
    g.globalAlpha = Math.min(1,(message.until-t)*5);
    text(message.text,w/2,lineY()-77,Math.min(26,w*.065),message.color);
    if (combo >= 3) text(combo+" COMBO",w/2,lineY()-46,16,"#fff");
    g.globalAlpha = 1;
  }

  if (banner && t < banner.until) {
    text(banner.text,w/2,h*.20,Math.min(23,w*.057),"#ffe59e");
  }

  if (t < LEAD + .35) {
    const label = t < LEAD ? String(Math.ceil(LEAD-t)) : "START!";
    text(label,w/2,h*.35,49);
    text("별이 선에 닿으면 톡!",w/2,h*.35+44,14,"#cfc0e5");
  }
}
function update(t) {
  const judgeTime = t - offset;
  for (const note of notes) {
    if (!note.done && judgeTime-note.time > level.window) judge(note,"miss",t);
  }

  const fever = isFever(t);
  const fill = fever ? (feverUntil-t)/FEVER_LENGTH*100 : energy;
  $("feverFill").style.width = Math.max(0,Math.min(100,fill))+"%";
  $("feverLabel").textContent = fever ? "🔥 ×2 "+Math.ceil(feverUntil-t)+"s" : "⚡ FEVER";
  const progress = Math.max(0,Math.min(100,(t-LEAD)/(BEATS*beat)*100));
  $("progressFill").style.width = progress+"%";

  if (t >= endTime) {
    for (const note of notes) if (!note.done) judge(note,"miss",t);
    finish();
  }
}
function frame(timestamp) {
  const delta = lastFrame ? Math.min((timestamp-lastFrame)/1000,.05) : 0;
  lastFrame = timestamp;

  if (state === "running") update(clock());
  if (state !== "paused") effects(delta);

  const t = clock();
  drawBackground(t,timestamp);

  if (state === "running" || state === "paused") {
    drawNotes(t);
    drawEffects();
    drawMessages(t);
  }
  requestAnimationFrame(frame);
}

/* ---------- 초기화 ---------- */

if ("ResizeObserver" in window) {
  new ResizeObserver(resize).observe(canvas);
} else {
  window.addEventListener("resize",resize);
}
muted = read("muted","false") === "true";
offsetLabel();
soundButton();
stats();
resize();
menu();
requestAnimationFrame(frame);
</script>
</body>
</html>


